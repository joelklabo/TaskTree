{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (uvicorn)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "tasktree.api.app:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      }
    },
    {
      "name": "Frontend: Vite (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "Dev: frontend (Vite)"
    },
    {
      "name": "Playwright: UI mode",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run e2e -- --ui",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Dev: backend + frontend",
      "configurations": [
        "Backend: FastAPI (uvicorn)",
        "Frontend: Vite (Chrome)"
      ]
    }
  ]
}
