{
  "name": "tasktree-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "lint:ox": "oxlint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/e2e**",
    "test:file": "vitest run --exclude tests/e2e** --run",
    "coverage": "vitest run --coverage --exclude tests/e2e**",
    "e2e": "BACKEND_PORT=18000 E2E_BACKEND_PORT=18000 VITE_DISABLE_CHECKER=1 playwright test",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/prismjs": "^1.26.5",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.554.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-flow-renderer": "^10.3.17",
    "react-simple-code-editor": "^0.14.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.0.12",
    "autoprefixer": "^10.4.22",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.36.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^27.2.0",
    "oxlint": "^1.31.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.3",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.0",
    "vite": "^7.3.1",
    "vite-plugin-checker": "^0.11.0",
    "vitest": "^4.0.12"
  },
  "knip": {
    "ignore": [
      "playwright.config.cjs",
      "tests/e2e/global-setup.ts",
      "src/components/ui/input.tsx",
      "src/components/ui/tooltip.tsx"
    ],
    "ignoreDependencies": [
      "@radix-ui/react-tooltip"
    ]
  }
}
