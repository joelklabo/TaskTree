#!/usr/bin/env bash
# Run the full CI suite locally before committing. Set SKIP_CI_HOOK=1 to bypass.
set -euo pipefail

if [[ "${SKIP_CI_HOOK:-}" == "1" ]]; then
  echo "[hook] SKIP_CI_HOOK=1 set; skipping pre-commit CI."
  exit 0
fi

echo "[hook] Running make ci (lint, tests, build)..."
make ci
echo "[hook] CI passed."
